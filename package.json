{
  "name": "aura-notesinger",
  "version": "1.0.0",
  "private": true,
  "description": "Aura Music + Aura Codex merged into one Firebase-hosted app with cloud snapshots.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only firestore,hosting",
    "deploy": "npm run build && firebase deploy",
    "deploy:rules": "firebase deploy --only firestore",
    "admin:check": "node scripts/admin-init.js"
  },
  "dependencies": {
    "firebase": "^11.10.0"
  },
  "devDependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-tools": "^14.11.0",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=20"
  }
}
